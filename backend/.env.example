# Backend (copy to backend/.env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=replace-with-long-random-string
LANGSMITH_API_KEY=

# mesh = hackathon submission | groq = local alternative
LLM_PROVIDER=mesh
MESH_API_KEY=rsk_your_mesh_key
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_MODEL=openai/gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

XAI_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1

# Agent trigger (fires after a small concentrated signal batch)
EVENT_TRIGGER_THRESHOLD=3
EVENT_COOLDOWN_SECONDS=45

# Frontend (copy to frontend/.env)
# VITE_API_URL=http://localhost:8000
